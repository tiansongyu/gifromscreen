# The cross-platform reference hashes the exact input and generator source.
# A Windows checkout must not create CRLF-only differences from Linux.
scripts/qa/wpf_reference/** text eol=lf
scripts/qa/run_wpf_reference.ps1 text eol=lf
.github/workflows/wpf-reference.yml text eol=lf
scripts/qa/cinemagraph_probe/** text eol=lf
.github/workflows/cinemagraph-probe.yml text eol=lf
packaging/licenses/upstream/dotnet-wpf-MIT.txt text eol=lf
# Unified-diff blank context lines contain one required space. Preserve the
# audited patch bytes instead of stripping those format markers.
packaging/appimage/runtime/cleanup.patch text eol=lf whitespace=-blank-at-eol
